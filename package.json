    "eslint": "7.32.0",
    "eslint-formatter-gitlab": "2.2.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import": "2.25.4",
    "husky": "8.0.1",
    "jest": "26.6.3",
    "jest-junit": "12.3.0",
    "moq.ts": "9.0.2",
