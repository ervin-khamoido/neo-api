    "@types/cors": "2.8.9",
    "@types/crypto-js": "4.1.1",
    "@types/elliptic": "6.4.14",
    "@types/express": "4.17.9",
    "@types/express-fileupload": "1.1.6",
    "@types/ioredis": "4.27.4",
    "@types/jest": "26.0.24",
