{
  "name": "neo-bank-api",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "ssh://git@gitlab.com:build-credit-with-me-llc/neo-bank/api.git",
  "author": "Ervin Khamoido",
  "license": "",
  "scripts": {
    "clean": "echo \"Clean...\" && rimraf ./dist",
    "build": "echo \"Building...\" && tsc --project tsconfig.json",
    "watch": "echo \"Building...\" && tsc -w --project tsconfig.json",
    "dev": "echo \"Nodemon...\" && doppler run -- nodemon --inspect=0.0.0.0:9229 -w ./dist ./dist/main.js",
    "dev:microservice:referrals": "echo \"Nodemon...\" && doppler run -- nodemon --inspect=0.0.0.0:9239 -w ./dist ./dist/microservice/referral-reward/index.js",
    "dev:microservice:push": "echo \"Nodemon...\" && doppler run -- nodemon --inspect=0.0.0.0:9239 -w ./dist ./dist/microservice/push/index.js",
    "dev:microservice:incoming-wallet-processor": "echo \"Nodemon...\" && doppler run -- nodemon --inspect=0.0.0.0:9239 -w ./dist ./dist/microservice/incoming-wallet-processor/index.js",
    "dev:microservice:reporting": "echo \"Nodemon...\" && doppler run -- nodemon --inspect=0.0.0.0:9239 -w ./dist ./dist/microservice/reporting/index.js",
    "copyMailTemplates": "copyfiles -u 1 src/**/**/*.html dist",
    "postbuild": "npm run copyMailTemplates",
    "run_changed_tests": "sh run-changed-tests.bash",
    "test_unit": "jest -c jest.config.unit.js",
    "test_integration": "jest -c jest.config.integration.js",
    "prepare": "husky install",
    "postwatch": "npm run copyMailTemplates",
    "lint": "eslint \"src/**/*.ts\"",
    "start:development": "echo \"Developing...\" \"npm run build\" && concurrently \"npm run watch\" \"npm run dev\"",
    "start:production": "echo \"Starting...\" && node index.js"
  },
  "dependencies": {
    "@bitgo/sdk-api": "1.11.1",
    "@bitgo/sdk-coin-avaxc": "2.4.17",
    "@ts-awesome/config": "1.0.0",
