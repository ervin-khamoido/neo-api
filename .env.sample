PORT=3000
DOMAIN=app.satoshi.com

DB_DATABASE=neo-bank
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

AUTH_SECRET=neo-bank_jwt_secret
AUTH_EXPIRES_IN=86400

CONFIRM_SECRET=neo-bank_jwt_confirm_secret
CONFIRM_EXPIRES_IN=3600

LOGGER_TYPE=CONSOLE
LOGGER_LEVEL=debug

MAILER_PROVIDER=mailgun # console, smtp
# if mailer provider is mailgun, then mailgun_* configs are required
MAILER_API_KEY=api-key
MAILER_SENDING_DOMAIN=sending-domain
MAILER_FROM=support@test.satoshi.com

SMS_PROVIDER=twilio # console
# if sms provider is twilio, then twilio_* configs are required
TWILIO_ACCOUNT_SID=adsf
TWILIO_AUTH_TOKEN=adsf
TWILIO_PHONE_NUMBER=adsf

KEY_VALUE_STORAGE_PROVIDER=local # redis. local means in memory storage
# if key-value storage is redis, then redis_* configs are required
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=1234

VERIFICATION_PROVIDER=twilio # self
# if verification provider is twilio, then twilio_* configs are required

ZENDESK_BASE_URL=https://xxxxxxxxxxxxx.zendesk.com
ZENDESK_API_KEY=zendesk-api-key
ZENDESK_EMAIL=buildcreditwithme@gmail.com

BRANCHIO_URL=https://api2.branch.io/v1
BRANCHIO_KEY=key_test_xxxxx
BRANCHIO_SECRET=secret_test_xxxxxx

GOOGLE_APPLICATION_CREDENTIALS=/the/path/to/firebase-adminsdk.json

AIRTABLE_API_KEY=keyXXXXXXXXXXXXXXX
AIRTABLE_CACHE_EXPIRES_IN=300
AIRTABLE_BASE=appXXXXXXXXXXX

TZ=UTC
